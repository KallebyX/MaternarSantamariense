# Porta da API (atrás do nginx na VM)
PORT=3000
# Interface de escuta — 127.0.0.1 quando atrás de proxy reverso na própria VM
HOST=127.0.0.1
# Caminho do banco SQLite (arquivo local na VM; inclua no rotina de backup)
DB_PATH=./data/maternar.db
# Segredo do JWT — OBRIGATÓRIO em produção (gere com: openssl rand -hex 32)
JWT_SECRET=troque-este-segredo
# Validade do token
JWT_EXPIRA=12h
# Diretório do frontend estático (index.html, app.html, painel.html + acervo/)
STATIC_DIR=..
# Onde ficam os arquivos enviados pelo painel (servidos em /uploads)
UPLOAD_DIR=./data/uploads
# Tamanho máximo de cada upload em MB (acompanhe o client_max_body_size do nginx)
UPLOAD_MAX_MB=64
# Origem liberada para CORS (vazio = mesma origem, sem CORS)
CORS_ORIGIN=
# Somente atrás de um único proxy reverso confiável:
TRUST_PROXY=0
# Envio real por SMTP. Preencha a senha somente no ambiente privado.
PUBLIC_URL=https://maternarsantamariense.app.ufn.edu.br
SMTP_ENABLED=false
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=maternar@ufn.edu.br
SMTP_FROM=maternar@ufn.edu.br
SMTP_PASSWORD=
# Alternativa: caminho absoluto de arquivo privado contendo apenas a senha.
# SMTP_PASSWORD_FILE=/run/secrets/maternar_smtp
